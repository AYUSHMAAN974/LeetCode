class Solution(object):
    def floodFill(self, image, sr, sc, color):
        """
        :type image: List[List[int]]
        :type sr: int
        :type sc: int
        :type color: int
        :rtype: List[List[int]]
        """

        def dfs(r,c):
            image[r][c] = color
            for dx,dy in [(-1,0),(1,0),(0,-1),(0,1)]:
                new_r, new_c = r + dx, c + dy
                if 0<=new_r<rows and 0<=new_c<cols and image[new_r][new_c]==og_color:
                    dfs(new_r,new_c)

        rows=len(image)
        cols=len(image[0])
        og_color = image[sr][sc]
        if og_color == color:
            return image
        dfs(sr,sc)
        return image
